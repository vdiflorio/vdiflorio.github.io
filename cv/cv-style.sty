% cv-style.sty — shared look for the academic and the industry CV.
% Same palette and typefaces as vdiflorio.github.io:
%   Zodiak (name, section titles) + Hanken Grotesk (text), ink #0e0e0f, oxblood #7d0c14.
% Build with LuaLaTeX (see cv/Makefile). Fonts come from cv/get-fonts.sh.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}[2026/11/09 CV style matching vdiflorio.github.io]

\RequirePackage{geometry}
\geometry{a4paper, top=1.8cm, bottom=2.2cm, left=2.3cm, right=2.3cm}

\RequirePackage{fontspec}
\setmainfont{HankenGrotesk}[
  Path = fonts/, Extension = .ttf,
  UprightFont = *-Regular, ItalicFont = *-Italic,
  BoldFont = *-SemiBold, BoldItalicFont = *-SemiBoldItalic,
  FontFace = {m}{n}{*-Regular}, FontFace = {mb}{n}{*-Medium},
  Numbers = {Lining, Proportional}]
\newfontfamily\display{Zodiak}[Path = fonts/, Extension = .ttf, UprightFont = *-Regular, BoldFont = *-Bold]
\newcommand{\medium}{\fontseries{mb}\selectfont}

\RequirePackage{xcolor}
\definecolor{ink}{HTML}{0E0E0F}
\definecolor{muted}{HTML}{55565B}
\definecolor{accent}{HTML}{7D0C14}
\color{ink}

\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{fontawesome5}
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=1.1em, labelsep=0.5em, itemsep=2pt, topsep=3pt, label={\color{muted}–}}

\RequirePackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true, urlcolor=accent, linkcolor=accent, pdfcreator={LuaLaTeX}}
\RequirePackage{xurl}
\urlstyle{same}
\newcommand{\doi}[1]{\href{https://doi.org/#1}{\nolinkurl{doi:#1}}}

\setcounter{secnumdepth}{0}
\RequirePackage{titlesec}
\RequirePackage{needspace}
\titleformat{\section}{\needspace{6\baselineskip}\display\fontsize{15.5}{19}\selectfont\color{accent}}{}{0pt}{}
\titlespacing*{\section}{0pt}{15pt}{5pt}
\titleformat{\subsection}{\medium\color{ink}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{6pt}{2pt}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}
\fancyhf{}
\newcommand{\lastupdated}{November 2026}
\fancyfoot[L]{\small\color{muted}Vincenzo Di Florio — CV}
\fancyfoot[R]{\small\color{muted}Last updated: \lastupdated\quad\thepage}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.08}

% --- Header -------------------------------------------------------------
% \cvheader{subtitle}
\newcommand{\cvheader}[1]{%
  {\display\fontsize{30}{32}\selectfont\color{accent}Vincenzo Di Florio, PhD\par}
  \vspace{4pt}
  {\large\color{muted}#1\par}
  \vspace{8pt}
  {\small
   \faMapMarker*\ Genova, Italy\quad
   \faEnvelope[regular]\ \href{mailto:vincenzo.diflorio@polimi.it}{vincenzo.diflorio@polimi.it}\quad
   \faEnvelope[regular]\ \href{mailto:vincenzo.diflorio97@gmail.com}{vincenzo.diflorio97@gmail.com}\par
   \vspace{3pt}
   \faGlobe\ \href{https://vdiflorio.github.io}{vdiflorio.github.io}\quad
   \faLinkedinIn\ \href{https://linkedin.com/in/vincenzo-di-florio-269b87401}{LinkedIn}\quad
   \faOrcid\ \href{https://orcid.org/0000-0002-9839-1518}{0000-0002-9839-1518}\quad
   \faGithub\ \href{https://github.com/vdiflorio}{vdiflorio}\quad
   \faGraduationCap\ \href{https://scholar.google.com/citations?user=t_W18NgAAAAJ}{Google Scholar}\par}
  \vspace{6pt}}

% --- Entries --------------------------------------------------------------
% \entry{title}{date}{place}: the date sits on the title's first line and never wraps.
\newlength{\datewidth}
\newcommand{\entry}[3]{%
  \par\addvspace{7pt}\noindent
  \settowidth{\datewidth}{#2}%
  \parbox[t]{\dimexpr\linewidth-\datewidth-1.5em\relax}{\RaggedRight\medium #1}%
  \hfill\mbox{\color{muted}#2}\par
  \ifx\relax#3\relax\else{\color{muted}#3\par}\fi}
% \detail{label}{text}
\newcommand{\detail}[2]{\par{\leftskip=1.1em\relax\textit{#1:}~#2\par}}

\endinput
